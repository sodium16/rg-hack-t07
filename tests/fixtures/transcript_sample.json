{
  "audio_id": "sha256-fixture-lecture-01",
  "duration_ms": 60000,
  "locale": "en-US",
  "phrases": [
    {
      "id": 1,
      "start_ms": 0,
      "end_ms": 6000,
      "text": "Today we will look at how a neural network learns from data.",
      "confidence": 0.94
    },
    {
      "id": 2,
      "start_ms": 6000,
      "end_ms": 14500,
      "text": "The key idea is gradient descent, which updates the weights in the direction of the negative gradient.",
      "confidence": 0.92,
      "words": [
        {"text": "The", "start_ms": 6000, "end_ms": 6500},
        {"text": "key", "start_ms": 6500, "end_ms": 7000},
        {"text": "idea", "start_ms": 7000, "end_ms": 7500},
        {"text": "is", "start_ms": 7500, "end_ms": 8000},
        {"text": "gradient", "start_ms": 8000, "end_ms": 8500},
        {"text": "descent", "start_ms": 8500, "end_ms": 9000},
        {"text": "which", "start_ms": 9000, "end_ms": 9500},
        {"text": "updates", "start_ms": 9500, "end_ms": 10000},
        {"text": "the", "start_ms": 10000, "end_ms": 10500},
        {"text": "weights", "start_ms": 10500, "end_ms": 11000},
        {"text": "in", "start_ms": 11000, "end_ms": 11500},
        {"text": "the", "start_ms": 11500, "end_ms": 12000},
        {"text": "direction", "start_ms": 12000, "end_ms": 12500},
        {"text": "of", "start_ms": 12500, "end_ms": 13000},
        {"text": "the", "start_ms": 13000, "end_ms": 13500},
        {"text": "negative", "start_ms": 13500, "end_ms": 14000},
        {"text": "gradient", "start_ms": 14000, "end_ms": 14500}
      ]
    },
    {
      "id": 3,
      "start_ms": 14500,
      "end_ms": 22000,
      "text": "Think of the loss as a landscape and the weights as a position on that landscape.",
      "confidence": 0.9
    },
    {
      "id": 4,
      "start_ms": 22000,
      "end_ms": 30000,
      "text": "At every step we measure the slope and take a small step downhill.",
      "confidence": 0.71
    },
    {
      "id": 5,
      "start_ms": 30000,
      "end_ms": 36000,
      "text": "The size of that step is the learning rate.",
      "confidence": 0.95
    },
    {
      "id": 6,
      "start_ms": 36000,
      "end_ms": 44000,
      "text": "If the learning rate is too large the training can diverge.",
      "confidence": 0.93
    },
    {
      "id": 7,
      "start_ms": 44000,
      "end_ms": 52000,
      "text": "The key idea is gradient descent, which updates the weights in the direction of the negative gradient.",
      "confidence": 0.9
    },
    {
      "id": 8,
      "start_ms": 52000,
      "end_ms": 60000,
      "text": "That is why we usually start with a small learning rate. Backpropagation makes this cheap because it reuses intermediate values.",
      "confidence": 0.88
    }
  ]
}
